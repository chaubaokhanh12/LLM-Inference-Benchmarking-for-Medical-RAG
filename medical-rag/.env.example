# ---------- LLM backend ----------
# One of: ollama | vllm | openai | groq | gemini
#
# Development default: Ollama on a laptop (docker/ollama/Modelfile).
# Recommended for serving (see ../inference-bench/README.md): vLLM with the AWQ 4-bit model —
# fastest configuration measured on an L4 and no measurable quality loss:
#   vllm serve Qwen/Qwen2.5-7B-Instruct-AWQ --served-model-name qwen2.5-7b --max-model-len 4096
#   LLM_BACKEND=vllm
#   LLM_MODEL=qwen2.5-7b
#   LLM_BASE_URL=http://<host>:8000/v1
LLM_BACKEND=ollama
LLM_MODEL=medrag-qwen2.5-3b
# Leave empty to use the default URL of the chosen backend:
#   ollama -> http://127.0.0.1:11434/v1   vllm -> http://127.0.0.1:8000/v1
#   openai -> https://api.openai.com/v1   groq -> https://api.groq.com/openai/v1
LLM_BASE_URL=
LLM_API_KEY=EMPTY
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120
# Context window of the served model; prompts are trimmed to fit.
LLM_CONTEXT_WINDOW=4096

# ---------- Retrieval ----------
EMBED_MODEL=intfloat/multilingual-e5-base
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# cuda | cpu | auto
EMBED_DEVICE=auto
RERANK_DEVICE=auto
RETRIEVE_K_DENSE=50
RETRIEVE_K_BM25=50
RETRIEVE_K_OUT=30
RRF_K=60
RERANK_TOP_N=5
# Sigmoid score in [0, 1]; below it the pipeline answers "not found" without the LLM.
# 0.3 = 70% of unanswerable questions caught, 1.2% of answerable ones lost (eval_retrieval.py)
RERANK_MIN_SCORE=0.3
INDEX_DIR=data/index

# ---------- Logging / API ----------
LOG_REQUESTS=true
LOG_DIR=logs
API_PORT=8080

# ---------- Evaluation (QA generation + LLM judge, OpenAI API) ----------
OPENAI_API_KEY=
EVAL_LLM_MODEL=gpt-4.1-mini-2025-04-14
